{
  "name": "banjo-practice",
  "version": "0.1.0",
  "private": true,
  "description": "Scruggs-style banjo practice PWA: notation, banjo tab, playback at any tempo and key.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:chaos": "vite build --mode chaos --outDir dist-chaos",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:prod-bundle": "node scripts/check-prod-bundle.mjs dist",
    "e2e": "playwright test --grep-invert @spike",
    "spike:s0": "playwright test --grep @spike",
    "icons": "node scripts/make-icons.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run check:prod-bundle"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "abcjs": "^6.4.4",
    "idb": "^8.0.0",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.53.0",
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "24.19.2",
    "eslint": "^9.29.0",
    "fast-check": "^4.1.0",
    "globals": "^16.2.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}
